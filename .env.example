# Public site URL (used for canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://saluviaindustries.com

# Google Search Console HTML-tag verification content value
# (Search Console → Settings → Ownership verification → HTML tag → content="...")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SMTP / Nodemailer — copy to .env.local and fill in real values.
# For Gmail: enable 2FA, then create an App Password (not your normal password).

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true

# Login email for SMTP
MAIL_USER=your-email@gmail.com

# Gmail App Password (16 characters, spaces optional)
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# From address shown on outbound mail (usually same as MAIL_USER)
MAIL_FROM="Saluvia Website <your-email@gmail.com>"

# Inbox that receives contact / quote inquiries
MAIL_TO=sales@your-domain.com
